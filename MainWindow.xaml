<Window x:Class="TicTacToeLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №2 — Хрестики-нулики"
        Width="440" Height="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="Рівень комп'ютера:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox SelectedIndex="{Binding SelectedLevelIndex}" Width="160" Margin="0,0,10,0">
                <ComboBoxItem Content="1 — Випадковий хід"/>
                <ComboBoxItem Content="2 — Блокування"/>
                <ComboBoxItem Content="3 — Розумний (виграш + блок)"/>
            </ComboBox>
            <Button Content="Нова гра" Command="{Binding NewGameCommand}" Padding="10,4" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Cells}" Width="330" Height="330">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Text}"
                            IsEnabled="{Binding IsEnabled}"
                            Command="{Binding ClickCommand}"
                            CommandParameter="{Binding}"
                            FontSize="36"
                            FontWeight="Bold"
                            Margin="4"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
